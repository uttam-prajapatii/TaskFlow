# ==========================================
# TaskFlow Backend Local Environment Variables Template
# Copy this file to '.env' and modify as needed
# ==========================================

NODE_ENV=development
PORT=5000
ALLOWED_ORIGINS=http://localhost:5173
EMAIL_LOGO_URL=https://res.cloudinary.com/kccnqqnu/image/upload/logo_qkcs9p.png
MONGO_URI=mongodb://localhost:27017/taskflow
REDIS_URL=redis://localhost:6379

# SMTP Configuration (Email Service)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM_ADDRESS=noreply@taskflow.app
RESEND_API_KEY=your_resend_api_key
APP_BASE_URL=http://localhost:5173

# JWT Configuration
JWT_ACCESS_SECRET=dev_access_secret_key_taskflow_987654321_abcde
JWT_REFRESH_SECRET=dev_refresh_secret_key_taskflow_123456789_fghij
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ACCESS_COOKIE_NAME=accessToken
JWT_REFRESH_COOKIE_NAME=refreshToken
JWT_COOKIE_HTTP_ONLY=true
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=lax
JWT_ACCESS_COOKIE_MAX_AGE=15m
JWT_REFRESH_COOKIE_MAX_AGE=7d

CLOUDINARY_CLOUD_NAME =
CLOUDINARY_API_KEY = 
CLOUDINARY_API_SECRET =

# Rate Limiting Configuration
# AUTH_RATE_LIMIT_WINDOW_MS: 15 minutes = 900000 ms
AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX: maximum number of registration/login requests per window
AUTH_RATE_LIMIT_MAX=5
# REFRESH_RATE_LIMIT_WINDOW_MS: 15 minutes = 900000 ms
REFRESH_RATE_LIMIT_WINDOW_MS=900000
# REFRESH_RATE_LIMIT_MAX: maximum number of token refresh requests per window
REFRESH_RATE_LIMIT_MAX=10