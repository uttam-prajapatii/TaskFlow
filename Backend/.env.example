# ==========================================
# TaskFlow Backend Local Environment Variables Template
# Copy this file to '.env' and modify as needed
# ==========================================

NODE_ENV=development
PORT=5000
ALLOWED_ORIGINS=http://localhost:5173
MONGO_URI=mongodb://localhost:27017/taskflow
REDIS_URL=redis://localhost:6379

# SMTP Configuration (Email Service)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM_ADDRESS=noreply@taskflow.app
APP_BASE_URL=http://localhost:5173

# JWT Configuration
JWT_ACCESS_SECRET=dev_access_secret_key_taskflow_987654321_abcde
JWT_REFRESH_SECRET=dev_refresh_secret_key_taskflow_123456789_fghij
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ACCESS_COOKIE_NAME=accessToken
JWT_REFRESH_COOKIE_NAME=refreshToken