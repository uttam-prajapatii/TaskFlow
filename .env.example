# ==========================================
# TaskFlow Unified Environment Variables Template
# Copy this file to '.env' and modify as needed
# ==========================================

# General Configuration
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173

# Backend Service Configuration
BACKEND_PORT=5000
MONGO_URI=mongodb://mongodb:27017/taskflow
REDIS_URL=redis://redis:6379

# SMTP Configuration (Email Service)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=noreply@taskflow.app
APP_BASE_URL=http://localhost:5173

# Frontend Service Configuration
FRONTEND_DEV_PORT=5173
FRONTEND_PROD_PORT=3000
VITE_API_URL=http://localhost:5000

# JWT Configuration
JWT_ACCESS_SECRET=dev_access_secret_key_taskflow_987654321_abcde
JWT_REFRESH_SECRET=dev_refresh_secret_key_taskflow_123456789_fghij
JWT_ACCESS_EXPIRY=1m
JWT_REFRESH_EXPIRY=7d
JWT_ACCESS_COOKIE_NAME=accessToken
JWT_REFRESH_COOKIE_NAME=refreshToken